{
	"name": "vkfft-addon",
	"version": "1.2.0",
	"private": true,
	"scripts": {
		"prepare": "node -e \"import('node:child_process').then(({execSync})=>{try{execSync('git rev-parse --is-inside-work-tree',{stdio:'ignore'});execSync('git config core.hooksPath .githooks')}catch{}})\" && node tools.mjs install",
		"fix": "concurrently -m 1 --group \"prettier --write .\" \"eslint . --fix --cache\" \"markdownlint-cli2 --fix \\\"**/*.md\\\"\" \"textlint --fix \\\"**/*.md\\\"\"",
		"check": "concurrently --group \"prettier --check .\" \"eslint . --no-cache -f unix\" \"markdownlint-cli2 \\\"**/*.md\\\"\" \"textlint -f compact \\\"**/*.md\\\"\" \"knip --no-progress\" \"jscpd .\" \"node tools.mjs run actionlint\"",
		"build": "cmake-js compile --CDCMAKE_BUILD_TYPE=Release",
		"rebuild": "cmake-js rebuild --CDCMAKE_BUILD_TYPE=Release"
	},
	"binary": {
		"napi_versions": [
			7
		]
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@stylistic/eslint-plugin": "^5.10.0",
		"cmake-js": "^8.0.0",
		"concurrently": "^10.0.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-formatter-unix": "^9.0.1",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-barrel-files": "^3.0.1",
		"eslint-plugin-comment-rules": "^0.1.7",
		"eslint-plugin-import-x": "^4.17.1",
		"globals": "^17.12.0",
		"jscpd": "^5.1.2",
		"knip": "^6.34.0",
		"markdownlint-cli2": "^0.23.2",
		"node-addon-api": "^8.6.0",
		"prettier": "^3.9.6",
		"textlint": "^15.8.0",
		"textlint-filter-rule-comments": "^1.3.0",
		"textlint-rule-no-dead-link": "^6.2.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0"
	},
	"allowScripts": {
		"unrs-resolver@1.12.2": true
	}
}
